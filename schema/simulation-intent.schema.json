{
  "$defs": {
    "AccelerationQuantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mm/s^2",
            "m/s^2"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "AccelerationQuantity",
      "type": "object"
    },
    "AmbiguousCadFaceTarget": {
      "additionalProperties": false,
      "description": "A blocked target whose local evidence has no unique stable identity.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "collision_group_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Collision Group Ids",
          "type": "array",
          "uniqueItems": true
        },
        "model_version_id": {
          "minLength": 1,
          "title": "Model Version Id",
          "type": "string"
        },
        "resolution": {
          "const": "ambiguous",
          "title": "Resolution",
          "type": "string"
        },
        "source_face_tags": {
          "description": "Source-local, non-authoritative numeric CAD-face evidence. It must not be used to rebind a region across ModelVersions. Valid positive unique tags represent unordered membership, so input order has no engineering meaning. This is the sole public numeric-evidence field for v3 CAD-face regions.",
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Source Face Tags",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "source_face_tags",
        "resolution",
        "model_version_id",
        "artifact_sha256",
        "collision_group_ids"
      ],
      "title": "AmbiguousCadFaceTarget",
      "type": "object"
    },
    "Analysis": {
      "additionalProperties": false,
      "description": "Analysis configuration.\n\n``dimensionality``, ``solver_target`` and ``coordinate_system`` were\nintroduced by schema version 2 and default to ``None`` — *explicitly\nmissing*, not silently approved.  A schema-version-1 payload migrated\nforward keeps them ``None`` and is therefore structurally incomplete until\nan engineer states them; a current-version submission must supply them.",
      "properties": {
        "coordinate_system": {
          "anyOf": [
            {
              "const": "global_cartesian",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate System"
        },
        "dimensionality": {
          "anyOf": [
            {
              "const": "3d_solid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensionality"
        },
        "solver_target": {
          "anyOf": [
            {
              "const": "calculix",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solver Target"
        },
        "type": {
          "const": "static_structural",
          "title": "Type",
          "type": "string"
        },
        "units": {
          "$ref": "#/$defs/Units"
        }
      },
      "required": [
        "type",
        "units"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "Auditable inference with a stable identity and explicit criticality.\n\nTask 1 assumptions predate explicit identifiers and criticality.  Defaults\nkeep those payloads valid, while the identifier is deterministically\nderived from immutable assumption content instead of an array index.",
      "properties": {
        "criticality": {
          "default": "noncritical",
          "enum": [
            "unit_critical",
            "noncritical"
          ],
          "title": "Criticality",
          "type": "string"
        },
        "id": {
          "default": "",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "material_proposal_fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Proposal Fingerprint Sha256"
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "status"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "ConcentratedForceLoad": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "distribution": {
          "const": "uniform",
          "default": "uniform",
          "title": "Distribution",
          "type": "string"
        },
        "magnitude_N": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude N"
        },
        "original_force": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForceQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region_ref": {
          "title": "Region Ref",
          "type": "string"
        },
        "type": {
          "const": "concentrated_force",
          "title": "Type",
          "type": "string"
        },
        "vector": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Vector",
          "type": "array"
        }
      },
      "required": [
        "type",
        "region_ref",
        "vector"
      ],
      "title": "ConcentratedForceLoad",
      "type": "object"
    },
    "DensityQuantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "kg/m^3",
            "kg/m3",
            "kg/m³",
            "t/mm^3",
            "tonne/mm^3"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "DensityQuantity",
      "type": "object"
    },
    "FixedDisplacementBC": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "enum": [
              "x",
              "y",
              "z"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "region_ref": {
          "title": "Region Ref",
          "type": "string"
        },
        "type": {
          "const": "fixed_displacement",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "region_ref",
        "components"
      ],
      "title": "FixedDisplacementBC",
      "type": "object"
    },
    "ForceQuantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "N",
            "kN",
            "MN"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "ForceQuantity",
      "type": "object"
    },
    "GravityLoad": {
      "additionalProperties": false,
      "description": "Model-wide gravity acceleration in mm/s^2.\n\n``region_ref`` stays ``None`` for the whole model; the only supported\nnon-null target is an element-set material domain (see\n``LOAD_REGION_COMPATIBILITY``).  A surface target is never valid.",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "distribution": {
          "const": "uniform",
          "default": "uniform",
          "title": "Distribution",
          "type": "string"
        },
        "magnitude_mm_per_s2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude Mm Per S2"
        },
        "original_acceleration": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccelerationQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Ref"
        },
        "type": {
          "const": "gravity",
          "title": "Type",
          "type": "string"
        },
        "vector": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Vector",
          "type": "array"
        }
      },
      "required": [
        "type",
        "vector"
      ],
      "title": "GravityLoad",
      "type": "object"
    },
    "InvalidLegacyCadFaceTarget": {
      "additionalProperties": false,
      "description": "Blocked historical v2 numeric evidence that violates v3 constraints.\n\nThis read-only migration representation deliberately permits non-positive\nand duplicate integers so immutable historical evidence remains readable\nand inspectable. It never confers stable geometry authority.",
      "properties": {
        "legacy_reason": {
          "const": "invalid_numeric_tags",
          "default": "invalid_numeric_tags",
          "title": "Legacy Reason",
          "type": "string"
        },
        "legacy_status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected"
          ],
          "title": "Legacy Status",
          "type": "string"
        },
        "resolution": {
          "const": "invalid_legacy_evidence",
          "title": "Resolution",
          "type": "string"
        },
        "source_face_tags": {
          "description": "Original ordered historical v2 numeric evidence, preserved without sorting, deduplication, sign changes, removal, repair, stable-identity fabrication, or ModelVersion rebinding. This evidence is invalid, non-authoritative, unconfirmable, and unexportable.",
          "items": {
            "type": "integer"
          },
          "title": "Source Face Tags",
          "type": "array"
        }
      },
      "required": [
        "resolution",
        "legacy_status",
        "source_face_tags"
      ],
      "title": "InvalidLegacyCadFaceTarget",
      "type": "object"
    },
    "LegacyCadFaceTarget": {
      "additionalProperties": false,
      "description": "Blocked valid v2 numeric evidence with no stable authority.",
      "properties": {
        "legacy_status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected"
          ],
          "title": "Legacy Status",
          "type": "string"
        },
        "resolution": {
          "const": "legacy_local_only",
          "title": "Resolution",
          "type": "string"
        },
        "source_face_tags": {
          "description": "Source-local, non-authoritative numeric CAD-face evidence. It must not be used to rebind a region across ModelVersions. Valid positive unique tags represent unordered membership, so input order has no engineering meaning. This is the sole public numeric-evidence field for v3 CAD-face regions.",
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Source Face Tags",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "resolution",
        "legacy_status"
      ],
      "title": "LegacyCadFaceTarget",
      "type": "object"
    },
    "LengthQuantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mm",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "LengthQuantity",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "E_MPa": {
          "exclusiveMinimum": 0,
          "title": "E Mpa",
          "type": "number"
        },
        "authority": {
          "default": "engineer_entered",
          "enum": [
            "engineer_entered",
            "system_proposed"
          ],
          "title": "Authority",
          "type": "string"
        },
        "density_original": {
          "anyOf": [
            {
              "$ref": "#/$defs/DensityQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "density_tonne_per_mm3": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Density Tonne Per Mm3"
        },
        "model": {
          "const": "linear_elastic_isotropic",
          "title": "Model",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nu": {
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": -1.0,
          "title": "Nu",
          "type": "number"
        },
        "proposal_assumption_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Assumption Ref"
        },
        "youngs_modulus_original": {
          "anyOf": [
            {
              "$ref": "#/$defs/StressQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "model",
        "E_MPa",
        "nu"
      ],
      "title": "Material",
      "type": "object"
    },
    "MeshSettings": {
      "additionalProperties": false,
      "description": "The deterministic preview meshing profile.\n\nEvery field is required: schema version 2 makes the meshing decision an\nexplicit client statement rather than a default a legacy payload could\nsilently acquire.",
      "properties": {
        "element_order": {
          "const": "first_order",
          "title": "Element Order",
          "type": "string"
        },
        "element_type": {
          "const": "tetrahedral",
          "title": "Element Type",
          "type": "string"
        },
        "global_element_size_mm": {
          "exclusiveMinimum": 0,
          "title": "Global Element Size Mm",
          "type": "number"
        },
        "mesher": {
          "const": "gmsh",
          "title": "Mesher",
          "type": "string"
        },
        "mesher_preset": {
          "const": "gmsh_tet_v1",
          "title": "Mesher Preset",
          "type": "string"
        },
        "target_size_original": {
          "anyOf": [
            {
              "$ref": "#/$defs/LengthQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "global_element_size_mm",
        "element_type",
        "element_order",
        "mesher",
        "mesher_preset"
      ],
      "title": "MeshSettings",
      "type": "object"
    },
    "PrescribedDisplacementBC": {
      "additionalProperties": false,
      "description": "Finite translational prescribed displacement in canonical millimetres.\n\nOnly the global Cartesian X/Y/Z translational components are representable.\nRotations, local/cylindrical coordinates, time dependence, and nonlinear\nbehavior have no fields in this strict model and are rejected rather than\napproximated.",
      "properties": {
        "components": {
          "additionalProperties": {
            "type": "number"
          },
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "x",
              "y",
              "z"
            ]
          },
          "title": "Components",
          "type": "object"
        },
        "components_original": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/LengthQuantity"
              },
              "propertyNames": {
                "enum": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components Original"
        },
        "region_ref": {
          "title": "Region Ref",
          "type": "string"
        },
        "type": {
          "const": "prescribed_displacement",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "region_ref",
        "components"
      ],
      "title": "PrescribedDisplacementBC",
      "type": "object"
    },
    "PressureLoad": {
      "additionalProperties": false,
      "description": "A nonnegative scalar pressure on the inward surface normal.\n\nThere is deliberately no ``direction`` field: the sign convention is the\nsurface normal, so a client-controlled direction is not representable and\n``extra=\"forbid\"`` rejects one.",
      "properties": {
        "distribution": {
          "const": "uniform",
          "default": "uniform",
          "title": "Distribution",
          "type": "string"
        },
        "magnitude": {
          "minimum": 0,
          "title": "Magnitude",
          "type": "number"
        },
        "original_pressure": {
          "anyOf": [
            {
              "$ref": "#/$defs/StressQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region_ref": {
          "title": "Region Ref",
          "type": "string"
        },
        "type": {
          "const": "pressure",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "region_ref",
        "magnitude"
      ],
      "title": "PressureLoad",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "required": [
              "entity_ids"
            ]
          },
          "if": {
            "properties": {
              "entity_type": {
                "const": "cad_face"
              }
            },
            "required": [
              "entity_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "entity_ids"
              ]
            }
          }
        }
      ],
      "properties": {
        "cad_face_target": {
          "anyOf": [
            {
              "description": "A resolved stable geometry identity is the authoritative CAD-face reference only for the exact bound ModelVersion and persisted geometry-identity artifact. Source-local numeric evidence never authorizes rebinding across ModelVersions. Ambiguous, unresolved, invalid-legacy, and legacy-local-only targets cannot be confirmed or exported. Even a resolved stable identity cannot become solver entities until an explicit CAD-to-mesh mapping exists. R4b.2 performs no cross-version identity transfer.",
              "discriminator": {
                "mapping": {
                  "ambiguous": "#/$defs/AmbiguousCadFaceTarget",
                  "invalid_legacy_evidence": "#/$defs/InvalidLegacyCadFaceTarget",
                  "legacy_local_only": "#/$defs/LegacyCadFaceTarget",
                  "resolved": "#/$defs/ResolvedCadFaceTarget",
                  "unresolved": "#/$defs/UnresolvedCadFaceTarget"
                },
                "propertyName": "resolution"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ResolvedCadFaceTarget"
                },
                {
                  "$ref": "#/$defs/AmbiguousCadFaceTarget"
                },
                {
                  "$ref": "#/$defs/UnresolvedCadFaceTarget"
                },
                {
                  "$ref": "#/$defs/LegacyCadFaceTarget"
                },
                {
                  "$ref": "#/$defs/InvalidLegacyCadFaceTarget"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A resolved stable geometry identity is the authoritative CAD-face reference only for the exact bound ModelVersion and persisted geometry-identity artifact. Source-local numeric evidence never authorizes rebinding across ModelVersions. Ambiguous, unresolved, invalid-legacy, and legacy-local-only targets cannot be confirmed or exported. Even a resolved stable identity cannot become solver entities until an explicit CAD-to-mesh mapping exists. R4b.2 performs no cross-version identity transfer.",
          "title": "Cad Face Target"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "entity_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required source-local entity membership for non-CAD regions. This field is forbidden for CAD-face regions, whose sole public numeric evidence is cad_face_target.source_face_tags.",
          "title": "Entity Ids"
        },
        "entity_type": {
          "enum": [
            "cad_face",
            "cad_edge",
            "mesh_face",
            "node_set",
            "element_set"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "selection_method": {
          "enum": [
            "semantic_geometry_query",
            "multimodal_reference",
            "user_click",
            "user_confirmed"
          ],
          "title": "Selection Method",
          "type": "string"
        },
        "source_instruction": {
          "title": "Source Instruction",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "entity_type",
        "selection_method",
        "confidence",
        "source_instruction",
        "status"
      ],
      "title": "Region",
      "type": "object"
    },
    "ResolvedCadFaceTarget": {
      "additionalProperties": false,
      "description": "A uniquely resolved stable target scoped to one exact artifact.",
      "properties": {
        "artifact_sha256": {
          "description": "SHA-256 of the exact persisted geometry-identity artifact that authorizes stable_identities for the bound ModelVersion.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "model_version_id": {
          "description": "Exact ModelVersion to which the authoritative stable identity is scoped; it cannot be transferred to another ModelVersion.",
          "minLength": 1,
          "title": "Model Version Id",
          "type": "string"
        },
        "resolution": {
          "const": "resolved",
          "title": "Resolution",
          "type": "string"
        },
        "source_face_tags": {
          "description": "Source-local, non-authoritative numeric CAD-face evidence. It must not be used to rebind a region across ModelVersions. Valid positive unique tags represent unordered membership, so input order has no engineering meaning. This is the sole public numeric-evidence field for v3 CAD-face regions.",
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Source Face Tags",
          "type": "array",
          "uniqueItems": true
        },
        "stable_identities": {
          "description": "Authoritative stable CAD-face identities for the exact model_version_id and persisted geometry-identity artifact identified by artifact_sha256. They do not transfer identity across ModelVersions and require a separate CAD-to-mesh mapping before solver entities can be produced.",
          "items": {
            "maxLength": 69,
            "minLength": 69,
            "pattern": "^gfi1:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Stable Identities",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "source_face_tags",
        "resolution",
        "model_version_id",
        "artifact_sha256",
        "stable_identities"
      ],
      "title": "ResolvedCadFaceTarget",
      "type": "object"
    },
